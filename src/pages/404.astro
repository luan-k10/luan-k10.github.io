---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

// O GitHub Pages usa esta mesma página para qualquer endereço inexistente, então ela é bilíngue.
---

<Base title="Página não encontrada · Page not found" noindex>
  <Header />
  <main class="container notfound">
    <p class="eyebrow">Erro · Error</p>
    <h1>404</h1>
    <p class="muted">Ops! Esta página não existe.</p>
    <p class="muted" lang="en">Oops! This page doesn't exist.</p>
    <div class="actions">
      <a class="btn btn-dark" href="/">Voltar ao início</a>
      <a class="btn btn-line" href="/en/" lang="en">Back to home</a>
    </div>
  </main>
</Base>

<style>
  .notfound {
    min-height: 70vh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
  }

  .notfound p {
    margin: 0 0 4px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }

  h1 {
    font: 500 96px/1 var(--mono);
    letter-spacing: -0.04em;
    margin: 16px 0 20px;
    color: var(--leather);
  }
</style>
