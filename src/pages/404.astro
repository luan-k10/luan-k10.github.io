---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---

<Base title="Página não encontrada" noindex>
  <Header />
  <main class="container notfound">
    <h1>404</h1>
    <p class="muted">Ops! Esta página não existe.</p>
    <a class="btn btn-primary" href="/">Voltar ao início</a>
  </main>
</Base>

<style>
  .notfound {
    min-height: 60vh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
  }

  h1 {
    font-size: 5rem;
    margin: 0;
    color: var(--accent);
  }
</style>
