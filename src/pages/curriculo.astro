---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { experience, formatMonth, formatPeriod } from '../data/experience';
import { skills } from '../data/skills';
import { awards, certificates } from '../data/certifications';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const display = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base title={`Currículo · ${profile.name}`} description={`Currículo de ${profile.name}: ${profile.headline}.`}>
  <div class="no-print">
    <Header />
  </div>
  <main class="page container">
    <div class="toolbar no-print">
      <p class="muted">Gerado a partir dos dados do site. Use “Salvar como PDF” na janela de impressão.</p>
      <button class="btn btn-primary" type="button" id="print"><Icon name="download" /> Imprimir / Salvar PDF</button>
    </div>

    <article class="cv card">
      <header class="cv-head">
        <h1>{profile.name}</h1>
        <p class="role">{profile.headline}</p>
        <ul class="contact">
          <li>{profile.location}</li>
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={profile.linkedin}>{display(profile.linkedin)}</a></li>
          <li><a href={profile.github}>{display(profile.github)}</a></li>
        </ul>
      </header>

      <section>
        <h2>Resumo</h2>
        <p>{profile.summary}</p>
      </section>

      <section>
        <h2>Experiência profissional</h2>
        {
          experience.map((job) =>
            job.roles.map((role) => (
              <div class="entry">
                <div class="entry-head">
                  <strong>
                    {role.title} · {job.company}
                  </strong>
                  <span>{formatPeriod(role)}</span>
                </div>
                {job.note && <p class="sub">{job.note}</p>}
                <ul>
                  {role.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )),
          )
        }
      </section>

      <section>
        <h2>Formação</h2>
        {
          profile.education.map((course) => (
            <div class="entry">
              <div class="entry-head">
                <strong>{course.title}</strong>
                <span>{course.period}</span>
              </div>
              <p class="sub">{course.institution}</p>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Projetos</h2>
        {
          projects.map((project) => (
            <div class="entry">
              <div class="entry-head">
                <strong>{project.data.title}</strong>
                {project.data.repo && <a href={project.data.repo}>{display(project.data.repo)}</a>}
              </div>
              <p class="sub">
                {project.data.context && <>{project.data.context}. </>}
                {project.data.summary} <em>({project.data.stack.join(', ')})</em>
              </p>
              {project.data.award && <p class="sub">{project.data.award}</p>}
            </div>
          ))
        }
      </section>

      <section>
        <h2>Prêmios</h2>
        {
          awards.map((award) => (
            <div class="entry">
              <div class="entry-head">
                <strong>{award.title}</strong>
                <span>{formatMonth(award.date)}</span>
              </div>
              <p class="sub">
                {award.issuer}. {award.description}
                {award.pdf && (
                  <>
                    {' '}
                    <a href={award.pdf} target="_blank" rel="noopener">
                      Ver certificado (PDF)
                    </a>
                  </>
                )}
              </p>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Certificados</h2>
        <ul class="skills">
          {
            certificates.map((cert) => (
              <li>
                <strong>{cert.title}</strong>: {cert.issuer}, {cert.hours} ({formatMonth(cert.date)}).{' '}
                <a href={cert.url}>{display(cert.url)}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Habilidades</h2>
        <ul class="skills">
          {
            skills.map((group) => (
              <li>
                <strong>{group.category}:</strong> {group.items.join(', ')}
              </li>
            ))
          }
          <li>
            <strong>Idiomas:</strong>
            {profile.languages.map((lang) => `${lang.name} (${lang.level.toLowerCase()})`).join(', ')}
          </li>
        </ul>
      </section>
    </article>
  </main>
</Base>

<script>
  document.getElementById('print')?.addEventListener('click', () => window.print());
</script>

<style>
  .page {
    max-width: 860px;
    padding-block: 2rem 4rem;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .toolbar p {
    margin: 0;
    font-size: 0.9rem;
  }

  .cv {
    padding: 2.5rem;
    font-size: 0.95rem;
  }

  .cv-head {
    border-bottom: 2px solid var(--accent);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 1.9rem;
    margin: 0;
  }

  .role {
    margin: 0.2rem 0 0.5rem;
    font-weight: 600;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--muted);
  }

  h2 {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin: 1.4rem 0 0.6rem;
  }

  section p {
    margin: 0;
  }

  .entry {
    margin-bottom: 0.85rem;
    break-inside: avoid;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1rem;
  }

  .entry-head span,
  .entry-head a {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .sub {
    color: var(--muted);
  }

  .entry ul,
  .skills {
    margin: 0.3rem 0 0;
    padding-left: 1.1rem;
  }

  @media print {
    @page {
      size: A4;
      margin: 14mm;
    }

    :global(:root) {
      --bg: #fff;
      --bg-elev: #fff;
      --text: #111;
      --muted: #444;
      --accent: #6e1423;
      color-scheme: light;
    }

    :global(body) {
      font-size: 10.5pt;
    }

    .no-print {
      display: none !important;
    }

    .page {
      padding: 0;
      width: 100%;
      max-width: none;
    }

    .cv {
      border: 0;
      box-shadow: none;
      padding: 0;
    }

    a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
