---
import { getProfile } from '../data/profile';
import { getLang, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const profile = getProfile(lang);

const channels = [
  { label: t.contact.email, value: profile.email, href: `mailto:${profile.email}` },
  { label: 'LinkedIn', value: profile.linkedin.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, ''), href: profile.linkedin },
  { label: 'GitHub', value: profile.github.replace(/^https:\/\//, ''), href: profile.github },
  { label: t.contact.location, value: profile.location },
];
---

<section id={t.sections.contact.id} class="contact">
  <div class="container inner">
    <div>
      <p class="eyebrow">{t.contact.eyebrow}</p>
      <h2>{t.contact.title}</h2>
      <p class="lead">{t.contact.lead}</p>
      <a class="btn btn-gold" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
    <ul>
      {
        channels.map((channel) => (
          <li>
            {channel.href ? (
              <a
                href={channel.href}
                {...(channel.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {channel.value}
              </a>
            ) : (
              <b>{channel.value}</b>
            )}
            <span>{channel.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    background: var(--deep);
    color: var(--deep-text);
    padding-block: 80px;
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: end;
  }

  .eyebrow {
    color: var(--gold);
  }

  h2 {
    font-size: 40px;
    letter-spacing: -0.02em;
    margin: 14px 0 16px;
  }

  .lead {
    color: var(--deep-body);
    margin: 0 0 28px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--deep-line);
  }

  li a,
  li b {
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  li a:hover {
    color: var(--gold-light);
  }

  li span {
    color: var(--deep-muted);
    font-size: 14px;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .contact {
      padding-block: 60px;
    }

    .inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    h2 {
      font-size: 30px;
    }

    li {
      flex-direction: column-reverse;
      gap: 2px;
    }
  }
</style>
