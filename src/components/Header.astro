---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getProfile } from '../data/profile';
import { getLang, routes, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const profile = getProfile(lang);
const home = routes.home[lang];

const links = Object.values(t.sections).map((section) => ({ href: `${home}#${section.id}`, label: section.label }));
---

<header class="header">
  <nav class="container nav" aria-label={t.nav.label}>
    <a class="brand" href={home} aria-label={`${profile.shortName} · ${t.nav.home}`}>
      <Logo class="mark" />
      <b>{profile.shortName}</b>
    </a>
    <ul class="menu">
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
    <div class="controls">
      <LanguageSwitcher />
      <ThemeToggle />
      <a class="btn btn-dark resume" href={routes.resume[lang]}>{t.nav.resume}</a>
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .nav {
    display: flex;
    align-items: center;
    min-height: 72px;
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
    color: var(--text);
  }

  .brand :global(.mark) {
    color: var(--brand);
  }

  .brand b {
    font-weight: 600;
    font-size: 16px;
    white-space: nowrap;
  }

  .menu {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14.5px;
  }

  .menu a {
    display: block;
    padding-block: 6px;
    color: var(--body);
    white-space: nowrap;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  .menu a:hover {
    color: var(--text);
    border-bottom-color: var(--gold);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .resume {
    height: 38px;
    font-size: 14px;
    padding: 0 16px;
    margin-left: 4px;
  }

  @media (max-width: 1040px) {
    .nav {
      flex-wrap: wrap;
      gap: 0 16px;
      padding-top: 10px;
      min-height: 0;
    }

    .menu {
      order: 3;
      width: 100%;
      overflow-x: auto;
      gap: 22px;
      padding-block: 8px 6px;
      scrollbar-width: none;
    }
  }

  @media (max-width: 700px) {
    .brand :global(.mark) {
      height: 24px;
      width: auto;
    }

    .menu {
      font-size: 14px;
    }
  }
</style>
