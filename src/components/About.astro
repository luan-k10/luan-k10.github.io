---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<section id="sobre" class="hero container">
  <div class="intro">
    <p class="eyebrow">Olá, eu sou</p>
    <h1>{profile.name}</h1>
    <p class="headline">{profile.headline}</p>
    <p class="location muted"><Icon name="pin" size={16} /> {profile.location}</p>
    <div class="about">
      {profile.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="actions">
      <a class="btn btn-primary" href="#contato"><Icon name="mail" /> Fale comigo</a>
      <a class="btn" href="/curriculo/"><Icon name="download" /> Currículo</a>
      <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer">
        <Icon name="github" /> GitHub
      </a>
      <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        <Icon name="linkedin" /> LinkedIn
      </a>
    </div>
  </div>
  <div class="photo-wrap">
    {
      profile.photo ? (
        <Image
          class="photo"
          src={profile.photo}
          alt={`Foto de ${profile.shortName}`}
          width={560}
          height={560}
          widths={[280, 560]}
          sizes="(max-width: 820px) 70vw, 280px"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="photo placeholder" role="img" aria-label={`Iniciais de ${profile.shortName}`}>
          {profile.initials}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-block: 5rem 3rem;
  }

  .eyebrow {
    margin: 0 0 0.25rem;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.1rem);
    letter-spacing: -0.02em;
  }

  .headline {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0.25rem 0;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 1.25rem;
  }

  .about p {
    margin: 0 0 0.75rem;
    color: var(--muted);
    max-width: 62ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .photo-wrap {
    display: flex;
    justify-content: center;
  }

  .photo {
    width: min(280px, 70vw);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 6px solid var(--bg-elev);
    box-shadow: var(--shadow), 0 0 0 2px var(--accent);
  }

  .placeholder {
    display: grid;
    place-items: center;
    font-size: 4.5rem;
    font-weight: 800;
    color: #fff;
    background: linear-gradient(135deg, #6e1423, #a8324a);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 3rem;
    }

    .photo-wrap {
      order: -1;
    }
  }
</style>
