---
import { getExperience } from '../data/experience';
import { getProfile } from '../data/profile';
import { getLang, routes, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const profile = getProfile(lang);
const experience = getExperience(lang);

const currentJob = experience.find((job) => job.roles.some((role) => role.current));
const currentRole = currentJob?.roles.find((role) => role.current);
const education = profile.education[0];
---

<section id={t.sections.about.id} class="container hero">
  <div>
    <p class="eyebrow">{t.about.eyebrow}</p>
    <h1>{profile.name}</h1>
    <p class="role">{profile.headline}</p>
    <p class="intro">{profile.intro}</p>
    <div class="actions">
      <a class="btn btn-dark" href={`#${t.sections.career.id}`}>{t.about.viewExperience}</a>
      <a class="btn btn-line" href={routes.resume[lang]}>{t.about.resume}</a>
      <a class="btn btn-line" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>

  <aside class="profile" aria-label={t.about.profileLabel}>
    <dl>
      {
        currentJob && currentRole && (
          <div>
            <dt>{t.about.current}</dt>
            <dd class="status">{currentRole.title}</dd>
            <dd>
              <small>{currentJob.company}</small>
            </dd>
          </div>
        )
      }
      {
        education && (
          <div>
            <dt>{t.about.education}</dt>
            <dd>
              {education.title}
              <small>
                {education.institution} · {education.period}
              </small>
            </dd>
          </div>
        )
      }
      <div>
        <dt>{t.about.mainTech}</dt>
        <dd>{profile.mainTech.join(', ')}</dd>
      </div>
      <div>
        <dt>{t.about.location}</dt>
        <dd>{profile.location}</dd>
      </div>
      <div>
        <dt>{t.about.languages}</dt>
        <dd>{profile.languages.map((language) => `${language.name} (${language.level.toLowerCase()})`).join(' · ')}</dd>
      </div>
    </dl>
  </aside>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 64px;
    padding-block: 80px;
    align-items: start;
  }

  h1 {
    font-size: 56px;
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin: 18px 0 14px;
  }

  .role {
    font-size: 21px;
    color: var(--leather);
    font-weight: 500;
    margin: 0 0 26px;
  }

  .intro {
    font-size: 17px;
    color: var(--body);
    max-width: 36em;
    margin: 0 0 34px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .profile {
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 28px 28px 8px;
  }

  dl {
    margin: 0;
  }

  dl > div {
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }

  dl > div:first-child {
    border-top: 0;
    padding-top: 0;
  }

  dt {
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 3px;
  }

  dd {
    margin: 0;
    font-weight: 500;
    font-size: 15px;
  }

  small {
    display: block;
    font-weight: 400;
    color: var(--muted);
    font-size: 14px;
  }

  .status {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .status::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--gold);
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .profile {
      max-width: 520px;
    }
  }

  @media (max-width: 700px) {
    .hero {
      gap: 36px;
      padding-block: 44px 56px;
    }

    h1 {
      font-size: 38px;
    }

    .role {
      font-size: 17px;
      margin-bottom: 18px;
    }

    .intro {
      font-size: 16px;
      margin-bottom: 26px;
    }

    .profile {
      padding: 22px 22px 6px;
    }
  }
</style>
