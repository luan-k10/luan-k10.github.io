---
import { getAwards, getCertificates } from '../data/certifications';
import { getLang, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const awards = getAwards(lang);
const certificates = getCertificates(lang);
---

<section id={t.sections.certificates.id} class="section">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{t.certifications.eyebrow}</p>
        <h2>{t.certifications.title}</h2>
      </div>
    </div>

    <ul class="certs">
      {
        awards.map((award) => (
          <li class="cert">
            <div>
              <span class="label">{t.certifications.award}</span>
              {award.pdf ? (
                <a class="title" href={award.pdf} target="_blank" rel="noopener" title={t.certifications.viewPdf}>
                  {award.title}
                </a>
              ) : (
                <b class="title">{award.title}</b>
              )}
              <p class="description">{award.description}</p>
            </div>
            <span class="issuer">{award.issuer}</span>
            <span class="date">{award.date}</span>
          </li>
        ))
      }
      {
        certificates.map((cert) => (
          <li class="cert">
            <div>
              <a class="title" href={cert.url} target="_blank" rel="noopener noreferrer" title={t.certifications.view}>
                {cert.title}
              </a>
            </div>
            <span class="issuer">
              {cert.issuer} · {cert.hours}
            </span>
            <span class="date">{cert.date}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .cert {
    display: grid;
    grid-template-columns: 1fr 260px 110px;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }

  .label {
    font: 600 11px/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    margin-right: 10px;
  }

  .title {
    font-weight: 500;
  }

  a.title {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }

  a.title:hover {
    text-decoration-color: var(--gold);
  }

  .description {
    margin: 6px 0 0;
    color: var(--body);
    font-size: 14.5px;
  }

  .issuer {
    color: var(--muted);
    font-size: 14.5px;
  }

  .date {
    font: 400 13.5px/1 var(--mono);
    color: var(--muted);
    text-align: right;
  }

  @media (max-width: 860px) {
    .cert {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .date {
      text-align: left;
    }
  }
</style>
