---
// Monograma "LK". A cor vem de `fill` (padrão: currentColor).
interface Props {
  height?: number;
  class?: string;
}

const { height = 28, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 367.9 460"
  height={height}
