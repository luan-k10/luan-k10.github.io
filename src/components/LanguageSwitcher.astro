---
import { getAlternates, getLang, htmlLang, routes, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const target = lang === 'pt' ? 'en' : 'pt';
const href = (getAlternates(Astro.url.pathname) ?? routes.home)[target];
---

<a
  class="icon-btn"
  href={href}
  hreflang={htmlLang[target]}
  lang={htmlLang[target]}
  aria-label={t.switcher.label}
  title={t.switcher.label}
>
  {t.switcher.short}
</a>
