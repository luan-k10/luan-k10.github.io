---
import { getExperience } from '../data/experience';
import { getLang, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const experience = getExperience(lang);
---

<section id={t.sections.career.id} class="section">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{t.career.eyebrow}</p>
        <h2>{t.career.title}</h2>
      </div>
      <p>{t.career.lead}</p>
    </div>

    {
      experience.map((job) => (
        <article class="job">
          <div class="period">
            <b>{job.company}</b>
            {job.period}
          </div>
          <div class="roles">
            {job.roles.map((role, index) => {
              const meta = [index === 0 ? job.note : undefined, job.roles.length > 1 ? role.period : undefined]
                .filter(Boolean)
                .join(' · ');
              return (
                <div class="role">
                  <h3>{role.title}</h3>
                  {meta && <p class="meta">{meta}</p>}
                  <ul>
                    {role.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .job {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }

  .job:last-child {
    border-bottom: 1px solid var(--line);
  }

  .period {
    font: 400 13.5px/1.6 var(--mono);
    color: var(--muted);
  }

  .period b {
    display: block;
    font: 600 15px/1.4 var(--sans);
    color: var(--text);
    margin-bottom: 4px;
  }

  .roles {
    display: grid;
    gap: 24px;
  }

  h3 {
    margin: 0 0 4px;
    font-size: 19px;
  }

  .meta {
    color: var(--leather);
    font-size: 15px;
    margin: 0;
  }

  ul {
    margin: 14px 0 0;
    padding-left: 18px;
    color: var(--body);
  }

  li {
    margin-bottom: 4px;
  }

  li::marker {
    color: var(--gold);
  }

  @media (max-width: 700px) {
    .job {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 24px 0;
    }
  }
</style>
