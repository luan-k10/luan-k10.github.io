---
import { experience, formatPeriod } from '../data/experience';
import { profile } from '../data/profile';
---

<section id="carreira" class="section container">
  <h2 class="section-title">Carreira</h2>
  <div class="columns">
    <ol class="timeline">
      {
        experience.map((job) => (
          <li class="item">
            <span class="dot" aria-hidden="true" />
            <div class="card">
              <h3>{job.company}</h3>
              {job.note && <p class="note muted">{job.note}</p>}
              {job.roles.map((role) => (
                <div class="role">
                  <div class="role-head">
                    <strong>{role.title}</strong>
                    <span class="period">{formatPeriod(role)}</span>
                  </div>
                  <ul>
                    {role.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </li>
        ))
      }
    </ol>

    <aside class="side">
      <div class="card">
        <h3>Formação</h3>
        {
          profile.education.map((course) => (
            <div class="edu">
              <strong>{course.title}</strong>
              <span class="muted">{course.institution}</span>
              {course.period && <span class="period">{course.period}</span>}
            </div>
          ))
        }
      </div>
      <div class="card">
        <h3>Idiomas</h3>
        {
          profile.languages.map((lang) => (
            <p class="lang">
              <strong>{lang.name}</strong> <span class="muted">· {lang.level}</span>
            </p>
          ))
        }
      </div>
    </aside>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 2px solid var(--border);
    display: grid;
    gap: 1.25rem;
  }

  .item {
    position: relative;
  }

  .dot {
    position: absolute;
    left: calc(-1.5rem - 7px);
    top: 1.6rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }

  h3 {
    font-size: 1.15rem;
  }

  .note {
    margin: -0.35rem 0 0.5rem;
    font-size: 0.9rem;
  }

  .role + .role {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--border);
  }

  .role-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .period {
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 600;
  }

  .role ul {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
  }

  .side {
    display: grid;
    gap: 1.25rem;
  }

  .edu {
    display: flex;
    flex-direction: column;
    margin-top: 0.75rem;
  }

  .lang {
    margin: 0.5rem 0 0;
  }

  @media (max-width: 820px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
