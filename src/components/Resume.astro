---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Icon from './Icon.astro';
import { getProfile } from '../data/profile';
import { getExperience } from '../data/experience';
import { getSkills } from '../data/skills';
import { getAwards, getCertificates } from '../data/certifications';
import { getProjects } from '../data/projects';
import { getLang, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const profile = getProfile(lang);
const experience = getExperience(lang);
const skills = getSkills(lang);
const awards = getAwards(lang);
const certificates = getCertificates(lang);
const projects = await getProjects(lang);
const display = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base title={t.resume.title(profile.name)} description={t.resume.description(profile.name, profile.headline)}>
  <div class="no-print">
    <Header />
  </div>
  <main class="page container">
    <div class="toolbar no-print">
      <p class="muted">{t.resume.hint}</p>
      <button class="btn btn-dark" type="button" id="print"><Icon name="download" /> {t.resume.print}</button>
    </div>

    <article class="cv">
      <header class="cv-head">
        <h1>{profile.name}</h1>
        <p class="role">{profile.headline}</p>
        <ul class="contact">
          <li>{profile.location}</li>
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={profile.linkedin}>{display(profile.linkedin)}</a></li>
          <li><a href={profile.github}>{display(profile.github)}</a></li>
        </ul>
      </header>

      <section>
        <h2>{t.resume.summary}</h2>
        <p>{profile.summary}</p>
      </section>

      <section>
        <h2>{t.resume.experience}</h2>
        {
          experience.map((job) =>
            job.roles.map((role) => (
              <div class="entry">
                <div class="entry-head">
                  <strong>
                    {role.title} · {job.company}
                  </strong>
                  <span>{role.period}</span>
                </div>
                {job.note && <p class="sub">{job.note}</p>}
                <ul>
                  {role.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )),
          )
        }
      </section>

      <section>
        <h2>{t.resume.education}</h2>
        {
          profile.education.map((course) => (
            <div class="entry">
              <div class="entry-head">
                <strong>{course.title}</strong>
                <span>{course.period}</span>
              </div>
              <p class="sub">{course.institution}</p>
            </div>
          ))
        }
      </section>

      <section>
        <h2>{t.resume.projects}</h2>
        {
          projects.map((project) => (
            <div class="entry">
              <div class="entry-head">
                <strong>{project.data.title}</strong>
                {project.data.repo && <a href={project.data.repo}>{display(project.data.repo)}</a>}
              </div>
              <p class="sub">
                {project.data.context && <>{project.data.context}. </>}
                {project.data.summary} <em>({project.data.stack.join(', ')})</em>
              </p>
              {project.data.award && <p class="sub">{project.data.award}</p>}
            </div>
          ))
        }
      </section>

      <section>
        <h2>{t.resume.awards}</h2>
        {
          awards.map((award) => (
            <div class="entry">
              <div class="entry-head">
                <strong>{award.title}</strong>
                <span>{award.date}</span>
              </div>
              <p class="sub">
                {award.issuer}. {award.description}
                {award.pdf && (
                  <>
                    {' '}
                    <a href={award.pdf} target="_blank" rel="noopener">
                      {t.resume.viewPdf}
                    </a>
                  </>
                )}
              </p>
            </div>
          ))
        }
      </section>

      <section>
        <h2>{t.resume.certificates}</h2>
        <ul class="skills">
          {
            certificates.map((cert) => (
              <li>
                <strong>{cert.title}</strong>: {cert.issuer}, {cert.hours} ({cert.date}).{' '}
                <a href={cert.url}>{display(cert.url)}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>{t.resume.skills}</h2>
        <ul class="skills">
          {
            skills.map((group) => (
              <li>
                <strong>{group.category}:</strong> {group.items.join(', ')}
              </li>
            ))
          }
          <li>
            <strong>{t.resume.languages}:</strong>{' '}
            {profile.languages.map((lang) => `${lang.name} (${lang.level.toLowerCase()})`).join(', ')}
          </li>
        </ul>
      </section>
    </article>
  </main>
</Base>

<script>
  document.getElementById('print')?.addEventListener('click', () => window.print());
</script>

<style>
  .page {
    max-width: 860px;
    padding-block: 2rem 4rem;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .toolbar p {
    margin: 0;
    font-size: 0.9rem;
  }

  .cv {
    padding: 48px;
    font-size: 15px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
  }

  .cv-head {
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 30px;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .role {
    margin: 0.2rem 0 0.5rem;
    font-weight: 500;
    color: var(--leather);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--muted);
  }

  h2 {
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gold);
    margin: 1.4rem 0 0.6rem;
  }

  section p {
    margin: 0;
  }

  .entry {
    margin-bottom: 0.85rem;
    break-inside: avoid;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1rem;
  }

  .entry-head span,
  .entry-head a {
    color: var(--muted);
    font: 400 13px/1.6 var(--mono);
  }

  .sub {
    color: var(--body);
  }

  .cv a:hover {
    color: var(--leather);
  }

  .entry li::marker,
  .skills li::marker {
    color: var(--gold);
  }

  .entry ul,
  .skills {
    margin: 0.3rem 0 0;
    padding-left: 1.1rem;
  }

  @media print {
    @page {
      size: A4;
      margin: 14mm;
    }

    :global(:root),
    :global(:root[data-theme='dark']) {
      --bg: #fff;
      --surface: #fff;
      --text: #231c16;
      --body: #3a3029;
      --muted: #5f554c;
      --line-strong: #cfc6b8;
      --leather: #6b4c33;
      --gold: #8a6a2c;
      color-scheme: light;
    }

    :global(body) {
      font-size: 10.5pt;
    }

    .no-print {
      display: none !important;
    }

    .page {
      padding: 0;
      width: 100%;
      max-width: none;
    }

    .cv {
      border: 0;
      padding: 0;
    }

    a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
