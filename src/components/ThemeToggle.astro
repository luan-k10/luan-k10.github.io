---
import Icon from './Icon.astro';
import { getLang, useTranslations } from '../i18n';

const t = useTranslations(getLang(Astro.currentLocale));
---

<button class="theme-toggle" type="button" aria-label={t.theme.label} title={t.theme.title}>
  <span class="icon-sun"><Icon name="sun" /></span>
  <span class="icon-moon"><Icon name="moon" /></span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  });
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text);
    cursor: pointer;
  }

  .icon-moon {
    display: none;
  }

  :global([data-theme='dark']) .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .icon-moon {
    display: inline;
  }
</style>
